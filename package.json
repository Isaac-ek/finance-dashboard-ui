{
  "name": "finance-dashboard-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "server": "node --experimental-strip-types server/index.mjs",
    "dev:accounts": "VITE_FINANCE_API=1 vite --host 127.0.0.1 --port 5186 --strictPort",
    "test:api": "node --experimental-strip-types --test server/*.test.mjs",
    "db:backup": "node server/backup.mjs",
    "test:e2e:accounts": "playwright test --config playwright.accounts.config.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "lucide-react": "^0.525.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.4",
    "zustand": "^5.0.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prettier": "^3.10.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
